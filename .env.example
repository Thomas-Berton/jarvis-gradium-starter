# ---- Gradium : la voix (obligatoire)
# Crée ton compte sur https://gradium.ai puis une clé API dans Gradium Studio.
# Participants du hackathon : active tes crédits avec le code reçu dans le kit
# (guide : https://gradium.link/how-to-redeem).
GRADIUM_API_KEY=
# Optionnel : rester en Europe (https://docs.gradium.ai/guides/data-residency)
# GRADIUM_BASE_URL=https://eu.api.gradium.ai/api/

# ---- L'agent qui agit sur ta machine
# claude (défaut), codex ou gemini. Il doit être installé et connecté.
# JARVIS_AGENT=claude
# Modèle de l'agent (vide = celui par défaut). Pour Claude : haiku est le plus
# rapide à répondre à la voix, sonnet / opus sont plus capables.
# JARVIS_MODEL=

# ---- Jarvis (optionnel)
# JARVIS_VOICE=Marius            # Marius, Jules, Gaspard, Damien, Augustin, Solène, Noémie,
#                                # Maëlys, Coralie, Apolline, Mélanie, Maude, ou un voice_id
# JARVIS_GREETING=Bonjour, je t'écoute.
# JARVIS_WORKDIR=./workspace     # dossier où l'agent travaille
# JARVIS_END_OF_TURN=0.8         # 0.5 = répond plus vite, 0.95 = te laisse plus de temps
# JARVIS_BARGE_IN=true           # tu peux couper la parole à Jarvis
# JARVIS_KEYWORDS=Jarvis         # mots que la transcription doit bien reconnaître (virgules)
# JARVIS_PERMISSION_TIMEOUT=120  # secondes avant refus automatique d'une autorisation
# JARVIS_PORT=8000
# JARVIS_OPEN_BROWSER=true

# Logs détaillés dans le terminal
DEBUG=false
